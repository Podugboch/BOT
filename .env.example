# Copy this file to .env and fill in real values. Never commit .env.
# Create keys with TRADE permission only — disable withdrawal permission.

# Which exchange + market to trade — see README "Supported exchanges" for popular ids.
EXCHANGE_ID=binance
SYMBOL=BTC/USDT
TIMEFRAME=5m
TESTNET=true

# Trading Execution Mode: auto (algorithmic automated trades) | manual (signals only, manual entry/exit)
EXECUTION_MODE=auto

# Trading Strategy: ema_cross_fib | pure_ema_cross | rsi_reversion | macd_crossover | bollinger_breakout
STRATEGY=ema_cross_fib

# Credentials — only needed for live mode, not paper or backtest.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only required by some exchanges (Coinbase, KuCoin, OKX, Bitget...). Leave blank otherwise.
EXCHANGE_API_PASSPHRASE=

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION (for live account verification & password reset emails)
# ==============================================================================
# Active provider: gmail | brevo | resend | sendgrid | smtp | none
EMAIL_PROVIDER=gmail

# Option 1: Gmail SMTP (Sends to ALL users — No custom domain required!)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
FROM_EMAIL=Crypto Trading Bot <your_email@gmail.com>

# Option 2: Brevo HTTP API (Recommended for Vercel if you do NOT have a custom domain)
# Free 300 emails/day to ANY recipient without domain DNS verification!
# 1. Sign up at https://brevo.com
# 2. Verify any sender email address in Senders & IP (e.g. your personal email)
# 3. Create an API Key in SMTP & API -> API Keys
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 3: Resend HTTP API (Recommended for Vercel IF you have a custom domain)
# IMPORTANT: Resend's default onboarding@resend.dev only allows sending to the account owner!
# To deliver verification emails to ALL users creating accounts:
# 1. Verify your domain at https://resend.com/domains (e.g. mail.yourdomain.com)
# 2. Set FROM_EMAIL to an address on your domain (e.g. Crypto Bot <noreply@yourdomain.com>)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Option 4: SendGrid HTTP API (100 free emails/day with Single Sender Verification)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# MASTER ENCRYPTION KEY (Required for Vercel / Cloud serverless environments)
# Generate a key using `python generate_keys.py` and set it in your Vercel Dashboard
# ==============================================================================
BOT_SECRET_KEY=

