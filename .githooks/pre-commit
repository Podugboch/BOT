#!/usr/bin/env bash
# Git Pre-Commit Security Hook
# Scans staged files for sensitive tokens, secrets, and dangerous anti-patterns.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$(dirname "$(realpath "$0")")")"
python3 "$REPO_ROOT/scripts/security_check.py" --staged --repo "$REPO_ROOT"
RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "❌ Commit aborted by pre-commit security check."
    echo "   Please fix the security findings above or unstage sensitive files."
    exit 1
fi

exit 0
